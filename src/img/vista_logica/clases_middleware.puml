@startuml

skinparam backgroundColor white
skinparam classBorderColor black
skinparam classBackgroundColor white
skinparam ArrowColor black
skinparam defaultFontColor black

' ============================================
' CLASES BASE
' ============================================

abstract class MessageMiddleware {
    + start_consuming(on_message_callback)
    + stop_consuming()
    + send(message)
    + close()
    + delete()
}

' ============================================
' BASE RABBIT IMPLEMENTATION
' ============================================

abstract class BaseRabbitMiddleware {
    - _rabbit_manager
    - _channel
    + __init__(host)
    + stop_consuming()
    + close()
    + delete()
    # _delete()
}

MessageMiddleware <|-- BaseRabbitMiddleware

' ============================================
' RABBITMQ IMPLEMENTATIONS
' ============================================

class RabbitQueueMiddleware {
    - queue_name
    + __init__(queue_name, host)
    + start_consuming(on_message_callback)
    + send(message_builder: CSVMessageBuilder)
    # _delete()
}

class RabbitExchangeMiddleware {
    - exch_name
    + __init__(queue_name, exchange_name, host)
    + start_consuming(on_message_callback)
    # _get_exchange_type()
}

class RabbitHashedExchangeMiddleware {
    - queue_name_base
    - node_count
    + __init__(queue_name_base, exchange_name, node_count, ind, host)
    + send(hashed_message_builder)
    # _get_exchange_type()
}

class RabbitMultiQueueExchangeMiddleware {
    - route_types
    - exch_name
    + __init__(route_keys, exchange_name, host)
    + start_consuming(on_message_callbacks)
    + send(message_builder: CSVMessageBuilder)
    # _initialize()
    # _get_exchange_type()
    # parse_queue_name(queue_type)
    # parse_real_route_key(msg_type)
    # _delete()
}

BaseRabbitMiddleware <|-- RabbitQueueMiddleware
RabbitQueueMiddleware <|-- RabbitExchangeMiddleware
RabbitExchangeMiddleware <|-- RabbitHashedExchangeMiddleware
BaseRabbitMiddleware <|-- RabbitMultiQueueExchangeMiddleware

' ============================================
' HIGH-LEVEL TASK MIDDLEWARES (NODOS DEL SISTEMA)
' ============================================

class ResultNodeMiddleware {
    + __init__(host, queue_name)
}

class SelectTasksMiddleware {
    + __init__(host, queue_name)
}

class JoinTasksMiddleware {
    + __init__(node_count, ind, host)
}

class GroupbyTasksMiddleware {
    + __init__(node_count, ind, host)
}

RabbitQueueMiddleware <|-- ResultNodeMiddleware
RabbitQueueMiddleware <|-- SelectTasksMiddleware
RabbitHashedExchangeMiddleware <|-- JoinTasksMiddleware
RabbitHashedExchangeMiddleware <|-- GroupbyTasksMiddleware

@enduml