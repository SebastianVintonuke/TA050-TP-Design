@startuml

skinparam backgroundColor transparent
skinparam shadowing false

skinparam defaultFontColor #121617
skinparam ArrowColor #121617

skinparam SequenceLifelineBorderColor #121617
skinparam SequenceActivationBorderColor #121617

skinparam EntityBorderColor #a9d4f1
skinparam ControlBackgroundColor #a9d4f1
skinparam ParticipantBackgroundColor #a9d4f1
skinparam QueueBackgroundColor #a9d4f1
skinparam RectangleBackgroundColor #a9d4f1

skinparam EntityBorderColor #44a0de
skinparam ControlBorderColor #44a0de
skinparam ParticipantBorderColor #44a0de
skinparam QueueBorderColor #44a0de
skinparam RectangleBorderColor #44a0de


control GroupNode
participant Middleware
participant TypeHandler
queue JoinQueue
control JoinNode

activate JoinNode
activate GroupNode

Middleware -> GroupNode: handle(task)
activate GroupNode
activate Middleware

GroupNode-> GroupNode: get_handler(task.type_query)
GroupNode-> TypeHandler : exec(task.data)
activate TypeHandler
TypeHandler --> GroupNode: (task_output, hash_key)
deactivate TypeHandler

GroupNode -> Middleware: send_output(hash_key, task_output)
activate Middleware


Middleware->Middleware: hash(hash_key)
Middleware -> JoinQueue: push_to(hashed_key, task_output)

Middleware -->GroupNode: 
deactivate Middleware
GroupNode --> Middleware: return
deactivate GroupNode
deactivate Middleware


JoinQueue -> Middleware: notify_not_empty
activate Middleware

Middleware -> JoinNode : handle(task)
activate JoinNode

JoinNode->JoinNode: exec(task)
JoinNode--> Middleware: return
deactivate Middleware
deactivate JoinNode


@enduml