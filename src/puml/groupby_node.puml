@startuml

skinparam backgroundColor transparent
skinparam shadowing false

skinparam defaultFontColor #121617
skinparam ArrowColor #121617

skinparam SequenceLifelineBorderColor #121617
skinparam SequenceActivationBorderColor #121617

skinparam EntityBorderColor #a9d4f1
skinparam ControlBackgroundColor #a9d4f1
skinparam ParticipantBackgroundColor #a9d4f1
skinparam QueueBackgroundColor #a9d4f1
skinparam RectangleBackgroundColor #a9d4f1

skinparam EntityBorderColor #44a0de
skinparam ControlBorderColor #44a0de
skinparam ParticipantBorderColor #44a0de
skinparam QueueBorderColor #44a0de
skinparam RectangleBorderColor #44a0de


control GroupbyNode
participant Middleware
participant TypeHandler
queue TopKQueue
control TopKNode

activate TopKNode
activate GroupbyNode

Middleware -> GroupbyNode: handle(task)
activate GroupbyNode
activate Middleware

GroupbyNode-> GroupbyNode: get_handler(task.type_query)
GroupbyNode-> TypeHandler : exec(task.data)
activate TypeHandler
TypeHandler --> GroupbyNode: (task_output, hash_key)
deactivate TypeHandler

GroupbyNode -> Middleware: send_output(hash_key, task_output)
activate Middleware


Middleware->Middleware: hash(hash_key)
Middleware -> TopKQueue: push_to(hashed_key, task_output)

Middleware -->GroupbyNode: 
deactivate Middleware
GroupbyNode --> Middleware: return
deactivate GroupbyNode
deactivate Middleware


TopKQueue -> Middleware: notify_not_empty
activate Middleware

Middleware -> TopKNode : handle(task)
activate TopKNode

TopKNode->TopKNode: exec(task)
TopKNode--> Middleware: return
deactivate Middleware
deactivate TopKNode


@enduml